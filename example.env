# User and timezone settings
PUID=1000
PGID=1000
TZ=Europe/Amsterdam
LAN_NETWORK=192.168.1.0/24

# Paths for configuration (SSD) and media/downloads (HDD)
SSD_PATH=./config
HDD_PATH=./hdd

# ProtonVPN credentials for qBittorrent VPN container
PROTONVPN_USERNAME=myuser
PROTONVPN_PASSWORD=mypw

# Vault Warden
# Generate with: openssl rand -base64 48
VAULTWARDEN_TOKEN=aaa111
VAULTWARDEN_DOMAIN=https://yoursite.com

# Backup settings
BACKUP_DIR=/mnt/backup
BACKUP_RETENTION_DAYS=14
BACKUP_CHECK_MOUNT=true

# Jellyfin
JELLYFIN_URL=https://jelly.domain.com

# Odoo
ODOO_DB_PASSWORD=aaa111

# Photos Core Settings
MEDIA_LOCATION=/home/myuser/photos
JWT_SECRET=aaa111

# Photos Monitoring (Grafana + Loki)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Photos Laptop Scaling Limits (Prevents overheating and thermal throttling)
RP__SCALER__PROFILES__LIGHT__MAX_WORKERS=3
RP__SCALER__PROFILES__THUMBNAILS__MAX_WORKERS=1
RP__SCALER__PROFILES__ML__MAX_WORKERS=1

# Active compose profiles (enables Photos monitoring stack)
COMPOSE_PROFILES=monitoring